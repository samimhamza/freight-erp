APP_NAME="ACME SHIPPING & LOGISTICS L.L.C"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=acme_logistics
DB_USERNAME=postgres
DB_PASSWORD=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE="acme_logistics_session"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="info@acmelogistics.example.com"
MAIL_FROM_NAME="ACME SHIPPING & LOGISTICS L.L.C"

COMPANY_NAME="ACME SHIPPING & LOGISTICS L.L.C"
COMPANY_LEGAL_NAME="ACME SHIPPING & LOGISTICS L.L.C"
COMPANY_ADDRESS="123 Logistics Boulevard, Suite 500"
COMPANY_CITY="Dubai"
COMPANY_COUNTRY="UAE"
COMPANY_PHONE="+971 4 123 4567"
COMPANY_EMAIL="info@acmelogistics.example.com"
COMPANY_WEBSITE="https://acmelogistics.example.com"
COMPANY_TRN="100000000000003"
COMPANY_CURRENCY="AED"

COMPANY_BANK_NAME="Demo Commercial Bank"
COMPANY_BANK_ACCOUNT_TITLE="ACME SHIPPING & LOGISTICS L.L.C"
COMPANY_BANK_ACCOUNT_NUMBER="12345678901234"
COMPANY_BANK_IBAN="AE120000001234567890123"
COMPANY_BANK_SWIFT="DEMOAEAD"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RESEND_KEY=
